#include<stdio.h>
int main()
{
    int arr[]={1,2,5,23,8,6,9,12};
    int largest=arr[0];
    int secondlargest=0;
    int n=sizeof(arr)/sizeof(arr[0]);
    //printf("%d",n);
    for(int i=1;i<=n;i++)
    {
        if(arr[i]>largest)
        {
            secondlargest=largest;
            largest=arr[i];
        }
        else if(arr[i]>secondlargest && arr[i]!=largest)
        {
            secondlargest=arr[i];
        }
    }
    printf("%d\n",largest);
    printf("%d",secondlargest);
}
