#include<stdio.h>
int main(){
    int i,total=0;
    int mid=0;
    int arr[]={1,9,5,7,6,4,8,4};
    int n=sizeof(arr)/sizeof(arr[0]);
    for(i=0;i<n;i++)
    {
        total+=arr[i];
    }
    //printf("%d",total);
    for(i=0;i<n;i++)
    {
        mid+=arr[i];
        if(total-mid==mid)
        {
            printf("The sum of left side is equal to the sum of right side");
            break;
        }
    }
    if(total-mid!=mid)
    {
            printf("it is not equal");
    }
}
